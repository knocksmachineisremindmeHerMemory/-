# 楽天デベロッパーズ (https://webservice.rakuten.co.jp/) で取得したアプリID
RAKUTEN_APP_ID=your_application_id_here

# 楽天アフィリエイトID (https://affiliate.rakuten.co.jp/ で取得、任意)
# 設定するとレスポンスにアフィリエイトリンク(affiliateUrl)が付与されます
RAKUTEN_AFFILIATE_ID=

# Threads API (https://developers.facebook.com/ でMeta Developerアプリを作成し、
# 「Threads API」プロダクトを追加、OAuth同意フローで取得する。ユーザー自身の作業が必要で
# このリポジトリのツールでは自動取得できません)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
