# 楽天デベロッパーズ (https://webservice.rakuten.co.jp/) で取得したアプリID
RAKUTEN_APP_ID=your_application_id_here

# 楽天デベロッパーズのアクセスキー(商品検索API 2026-07-01版で必須)
# --mode search を使う場合は必ず設定してください。--mode ranking のみなら不要です。
RAKUTEN_ACCESS_KEY=

# 楽天アフィリエイトID (https://affiliate.rakuten.co.jp/ で取得、任意)
# 設定するとレスポンスにアフィリエイトリンク(affiliateUrl)が付与されます
RAKUTEN_AFFILIATE_ID=

# Amazonアソシエイトのトラッキングタグ(任意)
# --asin 指定時のAmazon併記ブロック生成に使用します。--amazon-tag で都度上書きも可能。
AMAZON_TAG=
